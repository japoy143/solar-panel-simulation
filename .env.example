# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_…) or, on older projects, the "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Booking emails (https://resend.com → API Keys). Without RESEND_API_KEY, emails are skipped.
RESEND_API_KEY=
# Sender. Must be on a domain verified in Resend. Until then, use the test sender below:
# it can only deliver to the email address of your own Resend account.
EMAIL_FROM=Solar Layout <onboarding@resend.dev>
# Who gets "New booking" alerts (comma-separate several).
ADMIN_EMAIL=
# Public site URL, used for links in emails (e.g. https://yourdomain.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only "service_role" (or sb_secret_…) key from Supabase → Project Settings → API.
# Bypasses Row Level Security: never expose it to the browser. Used only to record the automatic
# booking emails in client threads and by the Resend webhook.
SUPABASE_SERVICE_ROLE_KEY=
# Two-way client conversations (see README → Client conversations).
# Receiving domain set up in Resend; client replies go to reply+<clientId>@ this domain.
INBOUND_DOMAIN=
# Signing secret of the Resend webhook pointing at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=

# Server log level: trace | debug | info | warn | error | fatal (default: debug in dev, info in prod).
LOG_LEVEL=
