{
  "permissions": {
    "allow": [
      "Bash(npm build)",
      "Bash(npm test )",
      "Bash(npm typecheck)",
      "Bash(git status)",
      "Bash(git diff )"
    ],
    "ask": ["Bash(git push)"],
    "deny": ["Read(.env)", "Read(.env.)", "Edit(.env)", "Edit(.env.)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.mjs) npx eslint --fix \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "eslint --fix"
          }
        ]
      }
    ]
  }
}
